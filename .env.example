# ─── Database Configuration (Local Docker MySQL) ──────────────────────────────────
MYSQL_URL=jdbc:mysql://localhost:3306/trendsearchor
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# ─── Spring Profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ─── JWT Secret (Required) ─────────────────────────────────────────────────────
# Generate a new secret with:
#   $bytes = New-Object byte[] 32
#   (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRET=your_base64_encoded_jwt_secret_here

# ─── OpenAlex API (Polite Pool) ───────────────────────────────────────────────
OPENALEX_MAILTO=your_email@example.com

# ─── VNPay Sandbox Configuration ─────────────────────────────────────────────
VNP_TMN_CODE=your_vnp_tmn_code_here
VNP_HASH_SECRET=your_vnp_hash_secret_here
